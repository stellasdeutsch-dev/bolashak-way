# Copy to .env.local (git-ignored) for local development of the cloud build.
# Both values come from Supabase → Project Settings → API. The anon key is public by
# design: Row Level Security is what protects the data, not the key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
